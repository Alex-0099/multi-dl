{
    "extractor": {
        "base-directory": "downloads/gallery-dl",
        "parent-directory": true,
        "postprocessors": [
            {
                "name": "exec",
                "command": "powershell -NoProfile -Command \"$f=[System.IO.Path]::ChangeExtension('{}','mp4'); ffmpeg -loglevel error -y -i '{}' -c:v libx264 -crf 23 -movflags +faststart -c:a aac $f; Remove-Item '{}'\"",
                "filter": "extension in ('gif', 'webm')",
                "event": "after"
            },
            {
                "name": "ugoira",
                "whitelist": [
                    "pixiv",
                    "danbooru"
                ],
                "ffmpeg-twopass": false,
                "extension": "mp4"
            },
            {
                "name": "metadata",
                "whitelist": [
                    "danbooru",
                    "yandere",
                    "sankaku"
                ],
                "mode": "tags"
            },
            {
                "name": "zip",
                "compression": "store",
                "extension": "cbz",
                "filter": "extension not in ('zip','rar','cbz','sqlite')",
                "keep-files": false,
                "event": "after",
                "whitelist": [
                    "nhentai",
                    "hitomi",
                    "comick",
                    "hdoujin",
                    "mangadex",
                    "mangoxo",
                    "tsumino"
                ]
            }
        ],
        "archive": [
            "data",
            "archives",
            "{category}.sqlite3"
        ],
        "browser": "firefox",
        "cookies": [
            "firefox"
        ],
        "cookies-update": true,
        "proxy": null,
        "skip": true,
        "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:135.0) Gecko/20100101 Firefox/135.0",
        "verify": true,
        "fallback": true,
        "retries": 11,
        "timeout": 30.0,
        "sleep-retries": "lin=5",
        "sleep": 3,
        "sleep-extractor": 5,
        "path-restrict": "auto",
        "path-replace": "_",
        "path-remove": "\\u0000-\\u001f\\u007f",
        "path-strip": "auto",
        "path-extended": true,
        "civitai": {
            "metadata": true,
            "files": [
                "model",
                "image",
                "gallery"
            ],
            "api-key": "",
            "directory": [
                "{category}",
                "{model_name}",
                "{user['username']}"
            ],
            "filename": "{file['id']}.{extension}",
            "include": [
                "user-models",
                "user-images",
                "user-videos",
                "user-collections",
                "user-posts"
            ]
        },
        "comick": {
            "browser": "chrome",

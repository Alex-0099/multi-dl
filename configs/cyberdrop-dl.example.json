{
  "// ─── MULTI_DOWNLOADER: cyberdrop-dl Modular Configuration ───": "",
  "// Base folder where cyberdrop-dl downloads will be saved": "",
  "download_dir": "downloads/cyberdrop-dl",
  "// Organize files under domain/site subfolders (e.g. downloads/cyberdrop-dl/<site>/...) matching gallery-dl": "",
  "organize_by_site": true,
  "// Flatten 'Loose Files (*)' folder so single files sit directly in the site directory (e.g. downloads/cyberdrop-dl/bunkr/file.mp4)": "",
  "flatten_loose_files": true,
  "// Avoid appending redundant domain names to album folders (e.g. 'Album Name' instead of 'Album Name (Domain)')": "",
  "include_domain_in_subfolders": false,
  "// Automatically retry via gallery-dl if cyberdrop-dl encounters HTTP 403 or anti-bot errors": "",
  "enable_failover_to_gallerydl": true,
  "// Optional FlareSolverr instance URL for Cloudflare bypass (e.g. http://127.0.0.1:8191/v1)": "",
  "flaresolverr": null,
  "// Optional HTTP/HTTPS/SOCKS5 proxy string": "",
  "proxy": null,
  "// Path to Netscape format cookies.txt file for authenticated hosts": "",
  "cookies_file": null,
  "// Max number of requests per second while scraping": "",
  "rate_limit": 25,
  "// Delete empty subfolders and zero-byte files after run": "",
  "delete_empty_folders": true,
  "// Enable creation of nested subfolders by domain / album": "",
  "subfolders": true,
  "// Create separate subfolders for every post when crawling forums": "",
  "separate_posts": false,
  "// Download files even if recorded in cyberdrop-dl's internal database history": "",
  "ignore_history": true,
  "ignore_hashes": true
}
